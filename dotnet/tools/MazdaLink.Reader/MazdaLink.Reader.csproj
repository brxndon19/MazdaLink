<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- J2534 cable drivers are 32-bit DLLs, so the reader must run as a 32-bit process. -->
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <AssemblyName>MazdaLinkReader</AssemblyName>
    <RootNamespace>MazdaLink.Reader</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SpeedLink.Core/SpeedLink.Core.csproj" />
    <ProjectReference Include="../../src/SpeedLink.J2534/SpeedLink.J2534.csproj" />
  </ItemGroup>
</Project>
